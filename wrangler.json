{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcforges-cloud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "arcforges.com/api/*",
      "zone_name": "arcforges.com"
    }
  ],
  "containers": [
    {
      "class_name": "CloudContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_CONTAINER",
        "class_name": "CloudContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudContainer"]
    }
  ],
  "ratelimits": [
    {
      "name": "HELLO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SOURCE_REVISION": "local"
  }
}
