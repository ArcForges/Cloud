{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcforges-cloud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "arcforges.com/api/*",
      "zone_name": "arcforges.com"
    }
  ],
  "containers": [
    {
      "class_name": "CloudContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_CONTAINER",
        "class_name": "CloudContainer"
      },
      {
        "name": "CAPACITY_PACER",
        "class_name": "CapacityJobPacer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudContainer"]
    },
    {
      "tag": "capacity-pacer-v1",
      "new_sqlite_classes": ["CapacityJobPacer"]
    }
  ],
  "ratelimits": [
    {
      "name": "HELLO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "COMMERCE_EGRESS": "production",
    "SOURCE_REVISION": "local"
  },
  "env": {
    "proof": {
      "name": "arcforges-cloud-proof",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["* * * * *"]
      },
      "routes": [
        {
          "pattern": "proof.arcforges.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./artifacts/proof-assets",
        "run_worker_first": ["/api/*", "/session/v1/*", "/proof/v1/*"],
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
      },
      "containers": [
        {
          "class_name": "FoundationContainer",
          "image": "./Dockerfile",
          "max_instances": 4,
          "instance_type": "lite"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CLOUD_CONTAINER",
            "class_name": "FoundationContainer"
          },
          {
            "name": "JOB_COORDINATOR",
            "class_name": "FoundationJobCoordinator"
          },
          {
            "name": "CAPACITY_PACER",
            "class_name": "CapacityJobPacer"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["FoundationContainer", "FoundationJobCoordinator"]
        },
        {
          "tag": "capacity-pacer-v1",
          "new_sqlite_classes": ["CapacityJobPacer"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcforges-proof-business",
          "migrations_dir": "worker/proof-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "arcforges-proof-objects"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "WAKE_QUEUE",
            "queue": "arcforges-proof-wake"
          }
        ],
        "consumers": [
          {
            "queue": "arcforges-proof-wake",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 6,
            "dead_letter_queue": "arcforges-proof-wake-dlq"
          },
          {
            "queue": "arcforges-proof-wake-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3
          }
        ]
      },
      "ratelimits": [
        {
          "name": "HELLO_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        }
      ],
      "vars": {
        "COMMERCE_EGRESS": "sandbox",
        "SOURCE_REVISION": "local",
        "FOUNDATION_PROOF": "enabled",
        "REALM_ID": "proof",
        "RECOVERY_GENERATION": "0",
        "ALLOWED_ORIGIN": "https://proof.arcforges.com",
        "PROOF_OPERATOR_VERIFIER": "jOWMycpHCCr-UWZoF6r7wNTteGrTbS5KxPOveANQUgc",
        "HMAC_C2W_KEY_ID": "c2w-1",
        "HMAC_W2C_KEY_ID": "w2c-1"
      }
    }
  }
}
