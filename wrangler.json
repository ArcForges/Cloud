{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcforges-cloud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "arcforges.com/api/*",
      "zone_name": "arcforges.com"
    }
  ],
  "containers": [
    {
      "class_name": "CloudContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_CONTAINER",
        "class_name": "CloudContainer"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudContainer"]
    },
    {
      "tag": "capacity-pacer-v1",
      "new_sqlite_classes": ["CapacityJobPacer"]
    },
    {
      "tag": "retire-capacity-pacer-v1",
      "deleted_classes": ["CapacityJobPacer"]
    }
  ],
  "ratelimits": [
    {
      "name": "HELLO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "IDENTITY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SOURCE_REVISION": "local",
    "ARCFORGES_NEON_HELLO": "enabled",
    "ARCFORGES_HELLO_RUNTIME": "go",
    "ARCFORGES_CENTER_MODE": "official-hosted",
    "ARCFORGES_CENTER_PUBLIC_BASE_URL": "https://arcforges.com/api",
    "FLAGSHIP_SURFACES": ""
  },
  "env": {
    "proof": {
      "name": "arcforges-cloud-proof",
      "main": "worker/acceptance/entry.ts",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {},
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "routes": [
        {
          "pattern": "proof.arcforges.com",
          "custom_domain": true
        }
      ],
      "containers": [
        {
          "class_name": "FoundationContainer",
          "image": "./Dockerfile",
          "max_instances": 1,
          "instance_type": "lite"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CLOUD_CONTAINER",
            "class_name": "FoundationContainer"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["FoundationContainer", "FoundationJobCoordinator"]
        },
        {
          "tag": "harness-run-alarm-v1",
          "new_sqlite_classes": ["HarnessRunAlarm"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcforges-proof-business",
          "migrations_dir": "worker/proof-migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "HELLO_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "IDENTITY_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": {
            "limit": 60,
            "period": 60
          }
        }
      ],
      "vars": {
        "SOURCE_REVISION": "local",
        "ARCFORGES_NEON_HELLO": "enabled",
        "ARCFORGES_HELLO_RUNTIME": "go",
        "ARCFORGES_CENTER_MODE": "official-hosted",
        "ARCFORGES_CENTER_PUBLIC_BASE_URL": "https://proof.arcforges.com/api",
        "ARCFORGES_CENTER_PLAN_CONFIGURATION": "development-fixtures",
        "FLAGSHIP_SURFACES": "identity",
        "ALLOWED_ORIGIN": "https://proof.arcforges.com"
      }
    }
  }
}
