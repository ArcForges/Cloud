      "roles": [
        "guard trustsafety revision a",
        "mutation trustsafety record a",
        "release platform release release"
      ]
    },
    {
      "name": "a mutation class on a guard",
      "valid": false,
      "roles": [
        "guard identity bucket a",
        "mutation identity record a",
        "release platform release release"
      ]
    },
    {
      "name": "a guard class on a mutation",
      "valid": false,
      "roles": [
        "guard identity revision a",
        "mutation identity authorization a",
        "release platform release release"
      ]
    }
  ],
