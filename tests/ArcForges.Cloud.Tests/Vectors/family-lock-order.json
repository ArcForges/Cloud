    },
    {
      "name": "a release that is not the platform's",
      "valid": false,
      "roles": [
        "guard identity revision a",
        "mutation identity record a",
        "release identity release release"
      ]
    },
    {
      "name": "no release at the end of a plan that ends with a mutation is still ordered but a release in the middle is not",
