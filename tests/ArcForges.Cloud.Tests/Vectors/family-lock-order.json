{
  "schemaVersion": 1,
  "source": "Design data model 00 SU-04: Config, Identity, Workspace, Device, Entitlement, Commerce, Policy, Agent, Chat, Scope, Task, Search, PackageCatalog, Notification, Resource, Sync, Audit. Platform lies outside the order: its guards come first, its receipt and outbox statements last. Support and TrustSafety have no position.",
  "lockOrder": [
    "config",
    "identity",
    "workspace",
    "device",
    "entitlement",
    "commerce",
    "policy",
    "agent",
    "chat",
    "scope",
    "task",
    "search",
    "package-catalog",
    "notification",
    "resource",
    "sync",
    "audit"
  ],
  "guardClassOrder": ["authorization", "revision", "policy", "balance", "lease"],
  "mutationClassOrder": ["bucket", "reservation", "record"],
  "orderCases": [
    {
      "name": "every phase in order with platform first and last",
      "valid": true,
      "roles": [
        "guard platform lease job-lease",
        "guard config policy active-config",
        "guard workspace authorization owner",
        "guard entitlement revision workspace-revision",
        "guard entitlement balance quota",
        "guard policy policy source-policy",
        "guard notification revision suppression",
        "mutation entitlement bucket quota",
        "mutation entitlement record revision",
        "mutation notification record suppression",
        "mutation platform record receipt",
        "release platform release release"
      ]
    },
    {
      "name": "the smallest valid family plan",
      "valid": true,
      "roles": [
        "guard identity revision user",
        "mutation identity record user",
        "release platform release release"
      ]
    },
    {
      "name": "all 17 modules in order, two statements each class",
      "valid": true,
      "roles": [
        "guard config authorization a",
        "guard identity authorization a",
        "guard workspace authorization a",
        "guard device authorization a",
        "guard entitlement authorization a",
        "guard commerce authorization a",
        "guard policy authorization a",
        "guard agent authorization a",
        "guard chat authorization a",
        "guard scope authorization a",
        "guard task authorization a",
        "guard search authorization a",
        "guard package-catalog authorization a",
        "guard notification authorization a",
        "guard resource authorization a",
        "guard sync authorization a",
        "guard audit authorization a",
        "mutation config record a",
        "mutation sync record a",
        "mutation audit bucket a",
        "mutation audit reservation a",
        "mutation audit record a",
        "mutation audit record b",
        "release platform release release"
      ]
    },
    {
      "name": "a mutation before a guard",
      "valid": false,
      "roles": [
        "mutation identity record user",
        "guard identity revision user",
        "release platform release release"
      ]
    },
    {
      "name": "the release before a mutation",
