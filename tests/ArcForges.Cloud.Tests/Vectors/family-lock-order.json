        "guard sync revision a",
        "guard audit revision a",
        "mutation audit record a",
        "mutation sync record a",
        "release platform release release"
      ]
    },
    {
      "name": "a platform guard after a module guard",
      "valid": false,
      "roles": [
        "guard identity revision a",
        "guard platform lease job-lease",
        "mutation identity record a",
        "release platform release release"
      ]
    },
    {
      "name": "a platform mutation before a module mutation",
      "valid": false,
      "roles": [
        "guard identity revision a",
        "mutation platform record receipt",
        "mutation identity record a",
        "release platform release release"
      ]
    },
    {
      "name": "policy class before revision inside one module",
