      "roles": [
        "guard identity revision user",
        "release platform release release",
        "mutation identity record user"
      ]
    },
    {
      "name": "workspace before identity among guards",
      "valid": false,
      "roles": [
        "guard workspace revision a",
        "guard identity revision a",
        "mutation workspace record a",
        "release platform release release"
      ]
    },
    {
