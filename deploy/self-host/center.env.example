# Install as /etc/arcforges-center/center.env. Set the same DNS name in caddy.env.
ARCFORGES_CENTER_MODE=self-hosted
ARCFORGES_CENTER_PUBLIC_BASE_URL=https://center.example.org/api
ARCFORGES_CENTER_SURFACES=identity,pages,fleet,relay,nodes
ARCFORGES_CENTER_HTTP_ADDRESS=127.0.0.1:8080
ARCFORGES_CENTER_GRPC_ADDRESS=127.0.0.1:8081
ARCFORGES_CENTER_ADMIN_ADDRESS=127.0.0.1:8082
ARCFORGES_CENTER_CLIENT_IP_HEADER=ArcForges-Client-IP
ARCFORGES_CENTER_TRUSTED_PROXIES=127.0.0.1/32
ARCFORGES_CENTER_MAX_CONNECTIONS=64
ARCFORGES_CENTER_MAX_NODE_CONNECTIONS=256
ARCFORGES_CENTER_DATABASE_MAX_CONNS=4
# Optional operator service limits use a comma-separated subset of
# center.nodes,remote.view,remote.control. Omit the variable to allow all three.
# ARCFORGES_CENTER_DISABLED_FEATURES=remote.control
