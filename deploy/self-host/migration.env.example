# Install privately as /etc/arcforges-center/migration.env for administration.
# Leave the URL unusable until the operator has supplied a URI-encoded password.
ARCFORGES_CENTER_MODE=self-hosted
ARCFORGES_CENTER_MIGRATION_DATABASE_URL='postgres://arcforges_owner@127.0.0.1:5432/postgres?sslmode=disable'
ARCFORGES_CENTER_DATABASE_NAME=arcforges
ARCFORGES_CENTER_RUNTIME_ROLE=arcforges_center_runtime
