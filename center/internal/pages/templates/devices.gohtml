{{define "content"}}
<h1 id="heading" tabindex="-1">Devices</h1>
<p id="status" role="status" aria-live="polite"></p>
<table>
<caption>Devices that have signed in to this account</caption>
<thead><tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Software</th><th scope="col">Actions</th></tr></thead>
<tbody>
{{range .Devices}}<tr>
<th scope="row">{{.Name}}{{if .Current}} (this browser){{end}}</th>
<td>{{.Platform}}</td>
<td>{{range $index, $item := .Installed}}{{if $index}}, {{end}}{{$item}}{{else}}None{{end}}</td>
<td class="actions">
<form method="post" action="{{$.Base}}/account/devices/rename" class="inline">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="command_id" value="{{.RenameCommand}}">
<input type="hidden" name="device_id" value="{{.ID}}">
<label for="device-{{.ID}}" class="visually-hidden">New name for device {{.Name}}</label>
<input id="device-{{.ID}}" name="name" type="text" maxlength="64" required value="{{.Name}}">
<button type="submit" aria-label="Rename device {{.Name}}">Rename</button>
</form>
<form method="post" action="{{$.Base}}/account/devices/revoke" class="inline"{{if not .Current}} data-step-up-class="device.revoke" data-step-up-target="{{.RevokeTarget}}"{{end}}>
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="command_id" value="{{.RevokeCommand}}">
<input type="hidden" name="device_id" value="{{.ID}}">
<button type="submit" aria-label="Revoke device {{.Name}}">Revoke</button>
</form>
</td>
</tr>
{{end}}
</tbody>
</table>
{{if .HasMore}}<p class="help">Only the first devices are listed.</p>{{end}}
{{end}}
