{{define "content"}}
<h1 id="heading" tabindex="-1">Connect a node</h1>
<noscript><p>Connecting a node needs JavaScript. Turn it on for this page and reload.</p></noscript>
<p id="needs-script" class="help">This page needs its script. If this line stays, reload the page or allow scripts for it.</p>
<p id="status" role="status" aria-live="polite">Reading the request.</p>
<form id="connect-review" method="post" action="{{.Base}}/connect/review" hidden>
<input type="hidden" name="csrf" value="">
<input type="hidden" name="flow_id" value="">
</form>
<p class="help">A node on your computer opened this page to connect to your account. You review the node before anything happens.</p>
{{end}}
