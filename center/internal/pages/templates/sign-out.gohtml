{{define "content"}}
<h1 id="heading" tabindex="-1">Sign out</h1>
<noscript><p>Signing out needs JavaScript. Turn it on for this page and reload. Until you sign out, this browser stays signed in until its session ends by itself.</p></noscript>
<p id="needs-script" class="help">This page needs its script. If this line stays, reload the page or allow scripts for it.</p>
<p id="status" role="status" aria-live="polite"></p>
<p>Signing out ends this browser's session. Your other sessions stay signed in until you end them.</p>
<p><button type="button" id="sign-out" class="primary" disabled>Sign out of this browser</button></p>
{{end}}
