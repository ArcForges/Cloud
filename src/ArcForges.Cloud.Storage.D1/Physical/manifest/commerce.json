  },
  "tables": [
    {
      "name": "commerce_billing_account",
      "model": "01 section 7 commerce.billing_account",
      "columns": [
        { "name": "billing_account_id", "type": "id" },
        { "name": "owner_user_id", "type": "id" },
        { "name": "created_at", "type": "instant" },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["billing_account_id"],
      "note": "Never keyed by email. No FK on owner_user_id: the model declares none."
    },
    {
      "name": "commerce_provider_customer",
      "model": "01 section 7 commerce.provider_customer",
      "columns": [
        { "name": "billing_account_id", "type": "id" },
        { "name": "provider", "type": "text" },
        { "name": "external_customer_ref", "type": "text" }
      ],
      "primaryKey": ["billing_account_id", "provider"],
      "indexes": [
        {
          "columns": ["provider", "external_customer_ref"],
          "unique": true,
          "path": "resolve a provider customer reference to its billing account"
        }
      ],
      "note": "The model marks billing_account_id only as PK part 1 and declares no FK, so none is written."
    },
    {
      "name": "commerce_offer",
      "model": "01 section 7 commerce.offer",
      "columns": [
        { "name": "offer_id", "type": "id" },
        { "name": "kind", "type": "enum", "enum": "commerce.offer_kind" },
        { "name": "name", "type": "text" },
        { "name": "scope", "type": "text" },
        { "name": "active", "type": "bool" },
        { "name": "term_profile", "type": "text" },
        { "name": "created_at", "type": "instant" },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["offer_id"],
      "note": "Only currently accepted CT-05 kinds are activated: a plan-level rule, not encoded here."
    },
    {
      "name": "commerce_price_version",
      "model": "01 section 7 commerce.price_version",
      "columns": [
        { "name": "price_version_id", "type": "id" },
        { "name": "offer_id", "type": "id" },
        { "name": "version", "type": "int64" },
        { "name": "amount", "type": "money" },
        { "name": "tax_category", "type": "text" },
        { "name": "starts_at", "type": "instant" },
        { "name": "ends_at", "type": "instant", "nullable": true },
        { "name": "config_revision_id", "type": "id" }
      ],
      "primaryKey": ["price_version_id"],
      "indexes": [
        {
          "columns": ["offer_id", "version"],
          "unique": true,
          "path": "one numbered version per offer"
        },
        { "columns": ["offer_id", "starts_at"], "path": "the effective price lookup for an offer" }
      ],
      "foreignKeys": [
        {
          "columns": ["offer_id"],
          "references": { "table": "commerce_offer", "columns": ["offer_id"] },
          "onDelete": "restrict"
        }
      ],
      "mutability": { "update": "none", "delete": "any" },
      "note": "Price versions are never mutated (PC-01). Restrict-delete once referenced is the restrict foreign keys from orders and attempts; deletion of an unreferenced version is not otherwise forbidden by the model."
    },
    {
      "name": "commerce_purchase_intent",
      "model": "01 section 7 commerce.purchase_intent",
      "columns": [
        { "name": "purchase_intent_id", "type": "id" },
        { "name": "billing_account_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "offer_id", "type": "id" },
        { "name": "price_version_id", "type": "id" },
        { "name": "state", "type": "enum", "enum": "commerce.purchase_intent_state" },
        { "name": "created_at", "type": "instant" },
        { "name": "expires_at", "type": "instant" }
      ],
      "primaryKey": ["purchase_intent_id"],
      "indexes": [{ "columns": ["state", "expires_at"], "path": "the expiry sweeper" }],
      "foreignKeys": [
        {
          "columns": ["billing_account_id"],
          "references": { "table": "commerce_billing_account", "columns": ["billing_account_id"] },
          "onDelete": "restrict"
        }
      ],
      "note": "Only billing_account_id carries a declared FK. The model states the at-most-one non-terminal checkout_attempt constraint here; it is realised as a partial unique index on commerce_checkout_attempt."
    },
    {
      "name": "commerce_checkout_attempt",
      "model": "01 section 7 commerce.checkout_attempt",
      "columns": [
        { "name": "attempt_id", "type": "id" },
        { "name": "intent_id", "type": "id" },
        { "name": "billing_account_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "offer_id", "type": "id" },
        { "name": "price_version_id", "type": "id" },
        { "name": "provider", "type": "text" },
        { "name": "external_session_ref", "type": "text", "nullable": true },
        { "name": "state", "type": "enum", "enum": "commerce.checkout_attempt_state" },
        { "name": "request_hash", "type": "hash" },
        { "name": "created_at", "type": "instant" },
        { "name": "expires_at", "type": "instant" },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["attempt_id"],
      "indexes": [
        {
          "columns": ["provider", "external_session_ref"],
          "unique": true,
          "path": "resolve a provider session reference to its attempt"
        },
        { "columns": ["intent_id", "created_at"], "path": "the attempts of one intent in order" },
        {
          "columns": ["intent_id"],
          "unique": true,
          "where": "\"state\" NOT IN (4, 5, 6)",
          "path": "at most one non-terminal checkout attempt per intent (PU-02)"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["intent_id"],
          "references": { "table": "commerce_purchase_intent", "columns": ["purchase_intent_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["billing_account_id"],
          "references": { "table": "commerce_billing_account", "columns": ["billing_account_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["workspace_id"],
          "references": { "table": "workspace_workspace", "columns": ["workspace_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["offer_id"],
          "references": { "table": "commerce_offer", "columns": ["offer_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["price_version_id"],
          "references": { "table": "commerce_price_version", "columns": ["price_version_id"] },
          "onDelete": "restrict"
        }
      ],
      "note": "Terminal states are completed, expired and failed (values 4, 5, 6); unknown is non-terminal. A browser return cannot advance state: a plan rule."
    },
    {
      "name": "commerce_provider_event",
      "model": "01 section 7 commerce.provider_event",
      "columns": [
        { "name": "provider_event_id", "type": "id" },
        { "name": "provider", "type": "text" },
        { "name": "external_event_id", "type": "text" },
        { "name": "event_type", "type": "text" },
        { "name": "raw_payload", "type": "json" },
        { "name": "signature_verified", "type": "bool" },
        { "name": "received_at", "type": "instant" },
        { "name": "processing_state", "type": "enum", "enum": "commerce.provider_event_state" },
        { "name": "retry_count", "type": "int" },
        { "name": "quarantine_reason", "type": "text", "nullable": true }
      ],
      "primaryKey": ["provider_event_id"],
      "indexes": [
        {
          "columns": ["provider", "event_type", "external_event_id"],
          "unique": true,
          "path": "the idempotency key of EI-02"
        },
        { "columns": ["processing_state", "received_at"], "path": "backlog age (AL-02)" }
      ],
      "checks": [
        {
          "name": "unverified_never_processed",
          "sql": "\"processing_state\" <> 2 OR \"signature_verified\" = 1"
        }
      ],
      "note": "An unverified event is stored and rejected, never processed (EI-01): expressed as a processed row requiring signature_verified."
    },
    {
      "name": "commerce_order",
      "model": "01 section 7 commerce.order",
      "columns": [
        { "name": "order_id", "type": "id" },
        { "name": "purchase_intent_id", "type": "id" },
        { "name": "billing_account_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "offer_id", "type": "id" },
        { "name": "price_version_id", "type": "id" },
        { "name": "amount", "type": "money" },
        { "name": "state", "type": "enum", "enum": "commerce.order_state" },
        { "name": "created_at", "type": "instant" },
        { "name": "completed_at", "type": "instant", "nullable": true },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["order_id"],
      "indexes": [
        {
          "columns": ["purchase_intent_id"],
          "unique": true,
          "path": "one order per purchase intent"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["purchase_intent_id"],
          "references": { "table": "commerce_purchase_intent", "columns": ["purchase_intent_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["billing_account_id"],
          "references": { "table": "commerce_billing_account", "columns": ["billing_account_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["workspace_id"],
          "references": { "table": "workspace_workspace", "columns": ["workspace_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["offer_id"],
          "references": { "table": "commerce_offer", "columns": ["offer_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["price_version_id"],
          "references": { "table": "commerce_price_version", "columns": ["price_version_id"] },
          "onDelete": "restrict"
        }
      ],
      "mutability": {
        "update": { "columns": ["state", "completed_at", "rev"], "when": "OLD.\"state\" = 1" },
        "delete": "any"
      },
      "note": "The physical table is commerce_order. Append-only after completion: while pending only state, completed_at and rev may change; the commercial terms (amount, references) are never updatable. The model gives no delete rule."
    },
    {
      "name": "commerce_payment",
      "model": "01 section 7 commerce.payment",
      "columns": [
        { "name": "payment_id", "type": "id" },
        { "name": "order_id", "type": "id" },
        { "name": "provider", "type": "text" },
        { "name": "provider_payment_ref", "type": "text" },
        { "name": "amount", "type": "money" },
        { "name": "state", "type": "enum", "enum": "commerce.payment_state" },
        { "name": "provider_event_id", "type": "id" },
        { "name": "created_at", "type": "instant" },
        { "name": "captured_at", "type": "instant", "nullable": true },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["payment_id"],
      "indexes": [
        {
          "columns": ["provider", "provider_payment_ref"],
          "unique": true,
          "path": "resolve a provider payment reference to its payment"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["order_id"],
          "references": { "table": "commerce_order", "columns": ["order_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["provider_event_id"],
          "references": { "table": "commerce_provider_event", "columns": ["provider_event_id"] },
          "onDelete": "restrict"
        }
      ],
      "note": "Omitted (guarded plan): captured only from verified provider evidence, and contradictory or older events never regress a capture."
    },
    {
      "name": "commerce_subscription",
      "model": "01 section 7 commerce.subscription",
      "columns": [
        { "name": "subscription_id", "type": "id" },
        { "name": "billing_account_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "offer_id", "type": "id" },
        { "name": "price_version_id", "type": "id" },
        { "name": "state", "type": "enum", "enum": "SubscriptionState" },
        { "name": "paid_through", "type": "instant" },
        { "name": "cancel_at_period_end", "type": "bool" },
        { "name": "external_subscription_ref", "type": "text", "nullable": true },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["subscription_id"],
      "indexes": [{ "columns": ["state", "paid_through"], "path": "the state-transition sweeper" }],
      "note": "The model declares no FK on this table. state is recomputed from paid_through plus the grace policy (a plan rule, not a row check)."
    },
    {
      "name": "commerce_credit_lot",
      "model": "01 section 7 commerce.credit_lot (rev per section 12 operator closure)",
      "columns": [
        { "name": "credit_lot_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "lot_class", "type": "enum", "enum": "commerce.lot_class" },
        { "name": "original_micro", "type": "int64" },
        { "name": "remaining_micro", "type": "int64" },
        { "name": "held_micro", "type": "int64" },
        { "name": "expires_at", "type": "instant", "nullable": true },
        { "name": "refund_hold", "type": "bool" },
        { "name": "source_ref", "type": "text", "nullable": true },
        { "name": "created_at", "type": "instant" },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["credit_lot_id"],
      "indexes": [
        {
          "columns": ["workspace_id", "lot_class", "refund_hold", "expires_at", "created_at"],
          "path": "the funding-order query (CD-05)"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["workspace_id"],
          "references": { "table": "workspace_workspace", "columns": ["workspace_id"] },
          "onDelete": "restrict"
        }
      ],
      "checks": [
        {
          "name": "balances_nonnegative",
          "sql": "\"remaining_micro\" >= 0 AND \"held_micro\" >= 0 AND \"held_micro\" <= \"remaining_micro\""
        },
        {
          "name": "purchased_never_expires",
          "sql": "\"lot_class\" <> 1 OR \"expires_at\" IS NULL"
        },
        {
          "name": "compensation_expires",
          "sql": "\"lot_class\" <> 2 OR \"expires_at\" IS NOT NULL"
        }
      ],
      "note": "source_ref carries the order or compensation-grant reference, and the proposal_id for administrative/time-compensation lots (operator closure rule, no new column). rev is the version every held/remaining mutation advances. A lot is never created by a refill: a plan rule."
    },
    {
      "name": "commerce_credit_transaction",
      "model": "01 section 7 commerce.credit_transaction",
      "columns": [
        { "name": "transaction_id", "type": "id" },
        { "name": "workspace_id", "type": "id" },
        { "name": "credit_lot_id", "type": "id" },
        { "name": "reservation_id", "type": "id", "nullable": true },
        { "name": "logical_request_id", "type": "id", "nullable": true },
        { "name": "kind", "type": "enum", "enum": "commerce.credit_transaction_kind" },
        { "name": "amount_micro", "type": "int64" },
        { "name": "reason", "type": "key" },
        { "name": "command_id", "type": "id" },
        { "name": "movement_ordinal", "type": "int" },
        { "name": "created_at", "type": "instant" }
      ],
      "primaryKey": ["transaction_id"],
      "indexes": [
        {
          "columns": ["command_id", "movement_ordinal"],
          "unique": true,
          "path": "one movement per command ordinal (idempotent retry)"
        },
        { "columns": ["credit_lot_id", "created_at"], "path": "the movement history of one lot" }
      ],
      "foreignKeys": [
        {
          "columns": ["workspace_id"],
          "references": { "table": "workspace_workspace", "columns": ["workspace_id"] },
          "onDelete": "restrict"
        },
        {
          "columns": ["credit_lot_id"],
          "references": { "table": "commerce_credit_lot", "columns": ["credit_lot_id"] },
          "onDelete": "restrict"
        }
      ],
      "mutability": { "update": "none", "delete": "none" }
    },
    {
      "name": "commerce_ledger_entry",
      "model": "01 section 7 commerce.ledger_entry",
      "columns": [
        { "name": "ledger_entry_id", "type": "id" },
        { "name": "ledger", "type": "enum", "enum": "commerce.ledger" },
        { "name": "workspace_id", "type": "id", "nullable": true },
        { "name": "amount_micro", "type": "int64", "nullable": true },
        { "name": "amount_money", "type": "decimal", "nullable": true },
        { "name": "currency", "type": "currency", "nullable": true },
        { "name": "occurred_at", "type": "instant" },
        { "name": "reference_kind", "type": "text" },
        { "name": "reference_id", "type": "id" },
        { "name": "created_at", "type": "instant" }
      ],
      "primaryKey": ["ledger_entry_id"],
      "indexes": [
        {
          "columns": ["ledger", "occurred_at"],
          "path": "one ledger in time order (reconciliation)"
        },
        {
          "columns": ["ledger", "workspace_id", "occurred_at"],
          "path": "one ledger for one workspace in time order"
        }
      ],
      "checks": [
        {
          "name": "customer_credit_units",
          "sql": "\"ledger\" <> 2 OR (\"amount_micro\" IS NOT NULL AND \"amount_money\" IS NULL AND \"currency\" IS NULL)"
        },
        {
          "name": "money_ledger_units",
          "sql": "\"ledger\" NOT IN (1, 3) OR (\"amount_money\" IS NOT NULL AND \"currency\" IS NOT NULL AND \"amount_micro\" IS NULL)"
        }
      ],
      "mutability": { "update": "none", "delete": "none" },
      "note": "Append-only: a correction is a new entry. amount_money is a plain signed decimal with its own nullable currency column, not the money type. Never netting distinct ledgers is a write-path rule."
    },
    {
      "name": "commerce_spend_budget",
      "model": "01 section 8.1 commerce.spend_budget",
      "columns": [
        { "name": "scope_kind", "type": "text" },
        { "name": "scope_id", "type": "text" },
        { "name": "period_key", "type": "text" },
        { "name": "unit", "type": "text" },
        { "name": "limit", "type": "decimal" },
        { "name": "used", "type": "decimal" },
        { "name": "held", "type": "decimal" },
        { "name": "rev", "type": "rev" },
        { "name": "period_ends_at", "type": "instant", "nullable": true }
      ],
      "primaryKey": ["scope_kind", "scope_id", "period_key", "unit"],
      "checks": [
        {
          "name": "nonnegative",
          "sql": "\"limit\" NOT GLOB '-*' AND \"used\" NOT GLOB '-*' AND \"held\" NOT GLOB '-*'"
        }
      ],
      "note": "decimal is canonical text, so limit, used and held >= 0 is encoded as not starting with a minus sign. Omitted: the integer-valued rule for the microcredit customer Run unit, and the no-mixed-unit-arithmetic rule (guarded plans)."
    },
    {
      "name": "commerce_spend_reservation",
      "model": "01 section 8.1 commerce.spend_reservation",
      "columns": [
        { "name": "reservation_id", "type": "id" },
        { "name": "provider_attempt_id", "type": "id", "nullable": true },
        { "name": "logical_request_id", "type": "id", "nullable": true },
        { "name": "scope_kind", "type": "text" },
        { "name": "scope_id", "type": "text" },
        { "name": "period_key", "type": "text" },
        { "name": "unit", "type": "text" },
        { "name": "bound", "type": "decimal" },
        { "name": "used", "type": "decimal" },
        { "name": "state", "type": "enum", "enum": "commerce.spend_reservation_state" },
