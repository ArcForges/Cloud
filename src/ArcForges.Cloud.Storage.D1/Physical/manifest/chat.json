          "type": "id"
        },
        {
          "name": "workspace_id",
          "type": "id"
        },
        {
          "name": "product_id",
          "type": "productId"
        },
        {
          "name": "turn_id",
          "type": "id"
        },
        {
          "name": "run_id",
          "type": "id"
        },
        {
          "name": "step_id",
          "type": "id"
        },
        {
          "name": "attempt_id",
          "type": "id"
        },
        {
          "name": "command_id",
          "type": "id"
        },
        {
          "name": "target_device_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "target_installation_id",
