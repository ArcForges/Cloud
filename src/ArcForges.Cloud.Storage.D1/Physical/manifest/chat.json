          "name": "device_target_full_or_none",
          "sql": "(\"target_device_id\" IS NOT NULL AND \"target_installation_id\" IS NOT NULL AND \"target_product_id\" IS NOT NULL) OR (\"target_device_id\" IS NULL AND \"target_installation_id\" IS NULL AND \"target_product_id\" IS NULL AND \"target_instance_epoch\" IS NULL)"
        }
      ],
