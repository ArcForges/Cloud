    {
      "name": "chat_turn",
      "model": "01 section 8 chat.turn and Chat-owned execution rules",
      "note": "Row-level history_mode rules encoded with HistoryMode local=1 cloud=2 temporary=3 and ChatMode ordinary=1 temporary=3: temporary requires mode temporary, others ordinary; cloud-history requires conversation and input message; local/temporary require origin_installation_id and null conversation/input/final message ids. Omitted (plan): committed final message or no-answer outcome before success, verified transient receipts, scope immutable at admission. FKs only on conversation_id and input_message_id (named in the model); final_message_id, run_id, stream_id carry none.",
      "columns": [
        {
          "name": "turn_id",
          "type": "id"
        },
        {
          "name": "workspace_id",
          "type": "id"
        },
        {
          "name": "product_id",
          "type": "productId"
        },
        {
          "name": "history_mode",
          "type": "enum",
          "enum": "HistoryMode"
        },
        {
          "name": "origin_installation_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "conversation_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "input_message_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "final_message_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "mode",
          "type": "enum",
          "enum": "ChatMode"
        },
        {
          "name": "state",
          "type": "enum",
          "enum": "ChatTurnState"
        },
        {
          "name": "rev",
          "type": "rev"
        },
        {
          "name": "run_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "stream_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "reason",
          "type": "key",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "instant"
        },
        {
          "name": "expires_at",
          "type": "instant",
          "nullable": true
        },
        {
          "name": "has_unknown_effect",
          "type": "bool"
        },
        {
          "name": "transient_input_ref",
          "type": "id",
          "nullable": true
        },
        {
          "name": "transient_output_receipt_id",
          "type": "id",
          "nullable": true
        }
      ],
      "primaryKey": ["turn_id"],
      "indexes": [
        {
          "columns": ["workspace_id", "input_message_id"],
          "unique": true,
          "path": "one turn per input message in a workspace"
        },
        {
          "columns": ["workspace_id", "product_id", "state", "created_at"],
          "path": "turn list by state"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["conversation_id"],
          "references": {
            "table": "chat_conversation",
            "columns": ["conversation_id"]
          },
          "onDelete": "restrict"
        },
        {
          "columns": ["input_message_id"],
          "references": {
            "table": "chat_message",
            "columns": ["message_id"]
          },
          "onDelete": "restrict"
        }
      ],
      "checks": [
        {
          "name": "temporary_requires_temporary_mode",
          "sql": "(\"history_mode\" = 3) = (\"mode\" = 3)"
        },
        {
          "name": "non_temporary_requires_ordinary_mode",
          "sql": "\"history_mode\" = 3 OR \"mode\" = 1"
        },
        {
          "name": "cloud_history_has_conversation_and_input",
          "sql": "\"history_mode\" <> 2 OR (\"conversation_id\" IS NOT NULL AND \"input_message_id\" IS NOT NULL)"
        },
        {
          "name": "local_or_temporary_has_no_cloud_rows",
          "sql": "\"history_mode\" = 2 OR (\"conversation_id\" IS NULL AND \"input_message_id\" IS NULL AND \"final_message_id\" IS NULL AND \"origin_installation_id\" IS NOT NULL)"
        }
      ]
    },
