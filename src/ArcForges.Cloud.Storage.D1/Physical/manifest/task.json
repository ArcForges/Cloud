{
  "schemaVersion": 1,
  "owner": "task",
  "enums": {
    "task.origin_surface": {
      "source": "model 01 section 8 task.task.origin_surface (inline, listed order)",
      "values": ["desktop", "web", "mobile", "automation"]
    },
    "task.history_mode": {
      "source": "model 01 section 8 task.task.history_mode (inline enum(local, cloud); the HistoryMode registry also has temporary, which cannot be an agent)",
      "values": ["local", "cloud"]
    },
    "task.iteration_output_state": {
      "source": "model 01 section 8 task.iteration_output.state (inline, listed order)",
      "values": ["complete", "interrupted", "refused", "toolProposals"]
    },
    "task.attempt_state": {
      "source": "model 01 section 8 task.attempt.state (inline, listed order)",
      "values": ["pending", "running", "succeeded", "failed", "canceled"]
    },
    "task.failure_class": {
      "source": "model 01 section 8 task.attempt.failure_class (inline, listed order)",
      "values": ["transient", "permanent", "refused", "canceled", "unknownEffect"]
    },
    "task.approval_state": {
      "source": "model 01 section 8 task.approval.state (inline, listed order)",
      "values": ["pending", "approved", "rejected", "expired", "withdrawn"]
    },
    "task.automation_occurrence_state": {
      "source": "model 01 section 8 task.automation_occurrence.state (inline, listed order)",
      "values": ["pending", "admitted", "skipped", "completed", "failed", "canceled"]
    },
    "task.tool_request_state": {
      "source": "model 01 section 8 task.tool_request.state (written queued/delivered/answered/expired/refused, listed order)",
      "values": ["queued", "delivered", "answered", "expired", "refused"]
    }
  },
  "tables": [
    {
      "name": "task_task",
      "model": "01 section 8 task.task",
      "note": "state/reason_facet use the named TaskState and TaskReasonFacet enums (waiting=3, none=1); history_mode is the inline task.history_mode enum (local=1, cloud=2), not the HistoryMode registry. Encoded: waiting facet, current_iteration >= 0, local history requires origin_installation_id, cloud history has null transient refs. Omitted (plan): terminal pointer exactness, final_message/no_answer rules.",
      "columns": [
        {
          "name": "task_id",
          "type": "id"
        },
        {
          "name": "workspace_id",
          "type": "id"
        },
        {
          "name": "origin_surface",
          "type": "enum",
          "enum": "task.origin_surface"
        },
        {
          "name": "origin_device_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "state",
          "type": "enum",
          "enum": "TaskState"
        },
        {
          "name": "reason_facet",
          "type": "enum",
          "enum": "TaskReasonFacet"
        },
        {
          "name": "intent_summary",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "instant"
        },
        {
          "name": "updated_at",
          "type": "instant"
        },
        {
          "name": "rev",
          "type": "rev"
        },
        {
          "name": "product_id",
          "type": "productId"
        },
        {
          "name": "origin_installation_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "transient_input_ref",
          "type": "id",
          "nullable": true
        },
        {
          "name": "transient_output_receipt_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "current_iteration",
          "type": "int"
        },
        {
          "name": "current_provider_attempt_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "final_message_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "terminal_output_commit_id",
          "type": "id",
          "nullable": true
        },
        {
          "name": "no_answer_reason",
          "type": "key",
          "nullable": true
        },
        {
          "name": "has_unknown_effect",
          "type": "bool"
        },
        {
          "name": "history_mode",
          "type": "enum",
          "enum": "task.history_mode"
        }
      ],
      "primaryKey": ["task_id"],
      "indexes": [
        {
          "columns": ["workspace_id", "state", "updated_at"],
          "path": "the task centre"
        }
      ],
      "checks": [
        {
          "name": "waiting_facet",
          "sql": "(\"state\" = 3) = (\"reason_facet\" <> 1)"
        },
        {
          "name": "current_iteration_nonnegative",
          "sql": "\"current_iteration\" >= 0"
        },
        {
          "name": "local_history_has_origin_installation",
          "sql": "\"history_mode\" <> 1 OR \"origin_installation_id\" IS NOT NULL"
        },
        {
          "name": "cloud_history_has_no_transient_refs",
          "sql": "\"history_mode\" <> 2 OR (\"transient_input_ref\" IS NULL AND \"transient_output_receipt_id\" IS NULL)"
        }
      ]
    },
