{
  "schemaVersion": 1,
  "owner": "identity",
  "enums": {
    "identity.user_state": {
      "source": "model 01 section 3 identity.user.state (inline, listed order)",
      "values": ["active", "restricted", "suspended", "pendingDeletion", "deleted"]
    },
    "identity.auth_method": {
      "source": "model 01 section 3 identity.auth_identity.method (inline, listed order)",
      "values": ["passkey", "emailCode", "password", "oidc"]
    },
    "identity.email_purpose": {
      "source": "model 01 section 3 identity.email_address.purpose (inline, listed order)",
      "values": ["primary", "recovery", "notification"]
    },
    "identity.credential_kind": {
      "source": "model 01 section 3 identity.session.credential_kind (inline, listed order)",
      "values": ["nativeBearer", "browserCookie"]
    },
    "identity.browser_flow_method": {
      "source": "model 01 section 3 identity.browser_auth_flow.method ('existing passkey/email method'); member names taken from identity.auth_identity.method",
      "values": ["passkey", "emailCode"]
    },
    "identity.step_up_state": {
      "source": "model 01 section 3 identity.step_up_challenge.state (inline, listed order)",
      "values": ["pending", "proved", "consumed", "expired", "denied"]
    },
    "identity.recovery_flow_state": {
      "source": "model 01 section 3 identity.recovery_flow.state (inline, listed order)",
      "values": ["pending", "proved", "completed", "expired", "denied"]
    },
    "identity.deletion_state": {
      "source": "model 01 section 3 identity.account_deletion.state (reviewed immutable deletion lifecycle producer)",
      "values": ["pending", "cancelled", "purging", "purged"]
    }
  },
  "tables": [
    {
      "name": "identity_user",
      "model": "01 section 3 identity.user",
      "columns": [
        { "name": "user_id", "type": "id" },
        { "name": "realm_id", "type": "id" },
        { "name": "display_name", "type": "text" },
        { "name": "state", "type": "enum", "enum": "identity.user_state" },
        { "name": "created_at", "type": "instant" },
        { "name": "deletion_requested_at", "type": "instant", "nullable": true },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["user_id"],
      "indexes": [{ "columns": ["realm_id", "state"], "path": "listing a realm's users by state" }],
      "note": "realm_id has no foreign key: model 01 says 'FK to realm' but no realm table exists in model 01. 'A deleted user retains the row with all personal fields cleared' is a lifecycle rule enforced by the deletion plan (display_name is NOT NULL, so 'cleared' has no row-level form)."
    },
    {
      "name": "identity_auth_identity",
      "model": "01 section 3 identity.auth_identity",
      "columns": [
        { "name": "auth_identity_id", "type": "id" },
        { "name": "user_id", "type": "id" },
        { "name": "method", "type": "enum", "enum": "identity.auth_method" },
        { "name": "subject", "type": "text" },
        { "name": "public_key", "type": "bytes", "nullable": true },
        { "name": "user_handle", "type": "bytes", "nullable": true },
        { "name": "backup_eligible", "type": "bool", "nullable": true },
        { "name": "backup_state", "type": "bool", "nullable": true },
        { "name": "transports", "type": "json", "nullable": true },
        { "name": "sign_count", "type": "int64", "nullable": true },
        { "name": "label", "type": "text", "nullable": true },
        { "name": "created_at", "type": "instant" },
        { "name": "last_used_at", "type": "instant", "nullable": true },
        { "name": "revoked_at", "type": "instant", "nullable": true },
        { "name": "realm_id", "type": "id" },
        { "name": "provider_id", "type": "text" },
        { "name": "password_hash", "type": "text", "nullable": true },
        { "name": "rev", "type": "rev" }
      ],
      "primaryKey": ["auth_identity_id"],
      "indexes": [
        {
          "columns": ["realm_id", "provider_id", "subject"],
          "unique": true,
          "path": "one configured-provider credential belongs to one user (credential lookup by provider subject)"
        },
        { "columns": ["user_id", "revoked_at"], "path": "listing a user's credentials" }
      ],
      "foreignKeys": [
        {
          "columns": ["user_id"],
          "references": { "table": "identity_user", "columns": ["user_id"] },
          "onDelete": "restrict"
        }
      ],
      "checks": [
        {
          "name": "backup_state_requires_backup_eligible",
          "sql": "\"backup_state\" IS NULL OR \"backup_eligible\" IS NOT NULL"
        },
        {
          "name": "passkey_requires_user_handle",
          "sql": "\"method\" <> 1 OR \"user_handle\" IS NOT NULL"
        },
        {
          "name": "password_hash_only_for_password",
          "sql": "\"method\" = 3 OR \"password_hash\" IS NULL"
        }
      ],
      "note": "The last-usable-credential rule (identity.last_credential) is cross-row and stays in the guarded plan. Passkey-only columns (public_key, backup_*, sign_count) are not forced null for other methods because the model only labels them as passkey data."
    },
    {
      "name": "identity_email_address",
      "model": "01 section 3 identity.email_address",
      "columns": [
        { "name": "email_id", "type": "id" },
        { "name": "user_id", "type": "id" },
        { "name": "address_normalised", "type": "text" },
        { "name": "verified_at", "type": "instant", "nullable": true },
        { "name": "purpose", "type": "enum", "enum": "identity.email_purpose" }
      ],
      "primaryKey": ["email_id"],
      "indexes": [
        {
          "columns": ["address_normalised", "purpose"],
          "unique": true,
          "where": "\"verified_at\" IS NOT NULL",
          "path": "verified address lookup for recovery and contact"
        }
      ],
      "foreignKeys": [
        {
          "columns": ["user_id"],
          "references": { "table": "identity_user", "columns": ["user_id"] },
          "onDelete": "cascade"
        }
      ],
      "note": "Model 01 gives no list index for user_id, so none is added. The FK cascades because the model says 'cascade on purge'."
    },
    {
      "name": "identity_session",
      "model": "01 section 3 identity.session",
      "columns": [
        { "name": "session_id", "type": "id" },
        { "name": "user_id", "type": "id" },
        { "name": "device_id", "type": "id" },
        { "name": "installation_id", "type": "id" },
        { "name": "issued_at", "type": "instant" },
        { "name": "expires_at", "type": "instant" },
        { "name": "revoked_at", "type": "instant", "nullable": true },
        { "name": "credential_kind", "type": "enum", "enum": "identity.credential_kind" },
        { "name": "refresh_token_hash", "type": "text", "nullable": true },
        { "name": "browser_handle_hash", "type": "text", "nullable": true },
        { "name": "browser_origin", "type": "text", "nullable": true },
        { "name": "idle_expires_at", "type": "instant", "nullable": true },
        { "name": "last_activity_at", "type": "instant", "nullable": true },
        { "name": "session_policy_version", "type": "text" },
        { "name": "refresh_generation", "type": "int", "nullable": true },
        { "name": "step_up_at", "type": "instant", "nullable": true },
        { "name": "step_up_classes", "type": "json", "root": "array" },
        { "name": "access_token_hash", "type": "text", "nullable": true },
        { "name": "access_expires_at", "type": "instant", "nullable": true },
        { "name": "csrf_hash", "type": "text", "nullable": true },
        { "name": "purpose", "type": "enum", "enum": "AuthPurpose" },
        { "name": "auth_epoch", "type": "int64" },
        { "name": "recovery_generation", "type": "int64" },
        { "name": "rev", "type": "int64" },
        { "name": "family_id", "type": "id", "nullable": true },
        { "name": "product_id", "type": "productId" }
      ],
      "primaryKey": ["session_id"],
      "indexes": [
        {
          "columns": ["user_id", "revoked_at", "expires_at"],
          "path": "active-session listing and mass revocation"
        },
        { "columns": ["device_id"], "path": "device revocation cascade" },
        {
          "columns": ["refresh_token_hash"],
          "unique": true,
          "where": "\"refresh_token_hash\" IS NOT NULL",
          "path": "native refresh-token lookup (partial unique for native sessions)"
        },
        {
          "columns": ["browser_handle_hash"],
          "unique": true,
          "where": "\"browser_handle_hash\" IS NOT NULL",
          "path": "browser handle lookup (partial unique for browser sessions)"
        },
        {
          "columns": ["access_token_hash"],
          "unique": true,
          "where": "\"access_token_hash\" IS NOT NULL",
          "path": "native access-token lookup (unique hash for nativeBearer)"
        },
        { "columns": ["browser_origin", "idle_expires_at"], "path": "browser expiry maintenance" }
      ],
      "foreignKeys": [
        {
          "columns": ["user_id"],
          "references": { "table": "identity_user", "columns": ["user_id"] },
          "onDelete": "cascade"
        },
        {
          "columns": ["device_id"],
          "references": { "table": "device_device", "columns": ["device_id"] },
          "onDelete": "restrict"
        }
      ],
      "checks": [
        {
          "name": "native_bearer_credential_shape",
          "sql": "\"credential_kind\" <> 1 OR (\"refresh_token_hash\" IS NOT NULL AND \"refresh_generation\" IS NOT NULL AND \"browser_handle_hash\" IS NULL AND \"browser_origin\" IS NULL AND \"idle_expires_at\" IS NULL)"
        },
        {
          "name": "browser_cookie_credential_shape",
          "sql": "\"credential_kind\" <> 2 OR (\"browser_handle_hash\" IS NOT NULL AND \"browser_origin\" IS NOT NULL AND \"idle_expires_at\" IS NOT NULL AND \"csrf_hash\" IS NOT NULL AND \"refresh_token_hash\" IS NULL AND \"refresh_generation\" IS NULL AND \"family_id\" IS NULL AND \"access_token_hash\" IS NULL)"
        },
        {
          "name": "refresh_hash_requires_family",
          "sql": "\"refresh_token_hash\" IS NULL OR \"family_id\" IS NOT NULL"
        },
        {
          "name": "access_hash_requires_access_expiry",
          "sql": "\"access_token_hash\" IS NULL OR \"access_expires_at\" IS NOT NULL"
        },
        {
          "name": "idle_expiry_not_after_absolute",
          "sql": "\"idle_expires_at\" IS NULL OR \"idle_expires_at\" <= \"expires_at\""
        }
      ],
      "note": "auth_epoch, recovery_generation and rev are typed bigint NN in the model, so they are int64 here (not rev) and are not marked monotonic because the model does not say 'monotonic'. installation_id has no foreign key because the model declares none. Superseded-generation family revocation, origin/idle checks at use, and the device/installation liveness invariant (CX-06) are guarded-plan rules."
    },
    {
      "name": "identity_browser_auth_flow",
      "model": "01 section 3 identity.browser_auth_flow",
      "columns": [
        { "name": "flow_id", "type": "id" },
        { "name": "binding_hash", "type": "text" },
        { "name": "origin", "type": "text" },
        { "name": "method", "type": "enum", "enum": "identity.browser_flow_method" },
        { "name": "purpose", "type": "enum", "enum": "AuthPurpose" },
        { "name": "challenge", "type": "json" },
        { "name": "created_at", "type": "instant" },
        { "name": "expires_at", "type": "instant" },
        { "name": "attempts", "type": "int" },
        { "name": "max_attempts", "type": "int" },
        { "name": "consumed_at", "type": "instant", "nullable": true },
        { "name": "csrf_hash", "type": "text" }
      ],
      "primaryKey": ["flow_id"],
      "indexes": [{ "columns": ["expires_at"], "path": "indexed expiry cleanup" }],
      "checks": [
        { "name": "purpose_authentication_recovery_enrollment", "sql": "\"purpose\" IN (1, 2, 4)" },
        {
          "name": "attempts_within_bound",
          "sql": "\"attempts\" >= 0 AND \"attempts\" <= \"max_attempts\""
        }
      ],
      "mutability": {
        "update": {
          "columns": [
            "flow_id",
            "binding_hash",
            "origin",
            "method",
            "purpose",
            "challenge",
            "created_at",
            "expires_at",
            "attempts",
            "max_attempts",
            "consumed_at",
            "csrf_hash"
          ],
          "when": "OLD.\"consumed_at\" IS NULL"
        },
        "delete": "any"
      },
      "note": "The model lists method/purpose only as 'enum NN' with prose values: method is the passkey/emailCode subset of auth_identity.method and purpose is AuthPurpose limited by a check to authenticate, enroll and recover (authentication/recovery/enrollment). 'One-way terminal consumption' is a row that cannot change once consumed_at is set; expired/consumed rows are purged, so delete stays any. attempts <= max_attempts encodes 'atomically bounded'."
    },
    {
      "name": "identity_step_up_challenge",
      "model": "01 section 3 identity.step_up_challenge",
      "columns": [
        { "name": "challenge_id", "type": "id" },
