        }
      ],
      "checks": [{ "name": "attempt_count_range", "sql": "\"attempt_count\" BETWEEN 0 AND 5" }],
      "note": "target_hash is typed text in the model (name ends _hash), so it stays text; proof_hash is typed hash."
    },
    {
      "name": "identity_recovery_flow",
      "model": "01 section 3 identity.recovery_flow",
      "columns": [
        { "name": "flow_id", "type": "id" },
        { "name": "realm_id", "type": "id" },
