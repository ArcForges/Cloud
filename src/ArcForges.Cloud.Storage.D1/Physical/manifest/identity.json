      "note": "No foreign keys: the model marks realm_id and user_id as plain id columns (user_id nullable until bound). 'No credential replacement before bound proof' is a guarded-plan rule."
    },
    {
      "name": "identity_spent_refresh",
      "model": "01 section 3 Account proofs and lifecycle records: spent_refresh",
      "columns": [
        { "name": "token_hash", "type": "hash" },
        { "name": "session_id", "type": "id" },
        { "name": "family_id", "type": "id" },
