{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "worker/router.ts",
    "tooling/**/*.ts",
    "eng/migrations/**/*.ts",
    "eng/verification/physical-schema.ts",
    "eng/verification/proof-bootstrap.ts",
    "eng/verification/browser/*.ts",
    "tests/worker/**/*.ts"
  ]
}
